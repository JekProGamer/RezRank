<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>bin\\Release\\RezRank\\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.369" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <Reference Include="WASDSharedAPI">
      <HintPath>lib/WASDSharedAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Put runtime dependencies in the CounterStrikeSharp shared folder layout. -->
  <Target Name="CopyDependenciesToShared" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_RezRankSharedDependency Include="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                          and '%(ReferenceCopyLocalPaths.Filename)' != 'CounterStrikeSharp.API'" />
    </ItemGroup>

    <Copy SourceFiles="@(_RezRankSharedDependency)"
          DestinationFiles="@(_RezRankSharedDependency->'$(MSBuildProjectDirectory)/bin/Release/shared/%(Filename)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Delete Files="@(_RezRankSharedDependency->'$(TargetDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
